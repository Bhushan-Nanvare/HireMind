generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Statuses the app controls are database enums, so an invalid value can't be written. Values produced by the
// AI (question difficulty, skill-gap importance) stay strings, since the model could return something new.

enum Role {
  CANDIDATE
  RECRUITER
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
}

enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ProctoringEventType {
  TAB_SWITCH
  COPY_PASTE
  PASTE_BLOCKED_IN_ANSWER
  SUSPICIOUS_TYPING_SPEED
  CANARY_TRIGGERED
  ANSWER_TIME_EXCEEDED
  TRANSCRIPT_HEAVILY_EDITED
  SPEECH_PATTERN_ANOMALY
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String
  role              Role
  createdAt         DateTime    @default(now())
  /// Null until the user opens the link in their verification email
  emailVerifiedAt   DateTime?
  /// Sessions (JWTs) issued before this moment are rejected; set when the password is reset
  passwordChangedAt DateTime?
  candidate         Candidate?
  recruiter         Recruiter?
  authTokens        AuthToken[]
}

/// Single-use tokens sent in emails. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Candidate {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  resumes      Resume[]
  applications Application[]
}

model Recruiter {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  jobPostings JobPosting[]
}

model JobPosting {
  id           String        @id @default(uuid())
  recruiterId  String
  recruiter    Recruiter     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  title        String
  description  String
  status       JobStatus     @default(OPEN)
  embedding    Float[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  applications Application[]
  mcqTest      McqTest?

  @@index([recruiterId])
  // The public job list: open jobs, newest first
  @@index([status, createdAt])
}

model Resume {
  id           String        @id @default(uuid())
  candidateId  String
  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Where the file is stored: "s3:<key>" in a bucket, or a path under uploads/ on local disk
  fileUrl      String
  /// The name of the file as uploaded
  fileName     String?
  parsedText   String?
  parsedSkills Json?
  embedding    Float[]
  createdAt    DateTime      @default(now())
  applications Application[]
  chunks       ResumeChunk[]

  @@index([candidateId])
}

/// A section of a resume, embedded on its own so a search can point at what actually matched.
model ResumeChunk {
  id         String                       @id @default(uuid())
  resumeId   String
  resume     Resume                       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  text       String
  orderIndex Int
  /// pgvector column with an HNSW index, searched with raw SQL: this table grows ~40 rows per
  /// resume, so it is the one place where scanning every row in Node would stop working.
  /// Prisma has no vector type, hence Unsupported and the raw queries in jobs.service.
  embedding  Unsupported("vector(1536)")?

  @@index([resumeId])
  /// Declared so Prisma knows an index exists here. The real one is HNSW with vector_cosine_ops,
  /// created in the migration: Prisma has no way to express that index type.
  @@index([embedding])
}

model Application {
  id               String            @id @default(uuid())
  candidateId      String
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId            String
  jobPosting       JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId         String
  resume           Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  matchScore       Float?
  status           ApplicationStatus @default(APPLIED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  interviewSession InterviewSession?
  mcqAttempt       McqAttempt?
  skillGaps        SkillGap[]

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([resumeId])
}

model InterviewSession {
  id               String              @id @default(uuid())
  applicationId    String              @unique
  application      Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status           InterviewStatus     @default(PENDING)
  startedAt        DateTime?
  endedAt          DateTime?
  questions        InterviewQuestion[]
  proctoringEvents ProctoringEvent[]
  report           Report?
}

model InterviewQuestion {
  id           String           @id @default(uuid())
  sessionId    String
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText String
  /// easy | medium | hard, chosen from the previous answer's score
  difficulty   String
  orderIndex   Int
  /// The unscored opening question, used only as a baseline for speech analysis. Always orderIndex 0.
  isWarmUp     Boolean          @default(false)
  /// Hidden instruction only a model reading the question would act on; see checkCanary()
  canaryToken  String?
  answer       InterviewAnswer?

  // Stops two concurrent requests from both creating "question N" for the same session
  @@unique([sessionId, orderIndex])
}

model InterviewAnswer {
  id                String            @id @default(uuid())
  questionId        String            @unique
  question          InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText        String
  /// Stored recording for voice answers, in the same format as Resume.fileUrl
  audioUrl          String?
  audioMimeType     String?
  score             Float?
  feedback          String?
  aiLikelihoodScore Int?
  /// What speech recognition heard, before the candidate edited it. Null for typed answers.
  rawTranscript     String?
  /// Timing and pacing of a spoken answer: latency, speech rate, pauses, edit distance
  voiceMetrics      Json?
  createdAt         DateTime          @default(now())
}

model SkillGap {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  missingSkill  String
  /// high | medium | low, as judged by the model
  importance    String

  @@index([applicationId])
}

model Report {
  id             String           @id @default(uuid())
  sessionId      String           @unique
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary        String
  recommendation String
}

model ProctoringEvent {
  id        String              @id @default(uuid())
  sessionId String
  session   InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType ProctoringEventType
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([sessionId])
}

enum McqEventType {
  TAB_SWITCH
  COPY_PASTE
  ANSWERED_TOO_FAST
}

model McqTest {
  id              String        @id @default(uuid())
  jobId           String        @unique
  job             JobPosting    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title           String
  durationMinutes Int
  /// How many questions each candidate draws from the pool
  questionCount   Int
  passPercent     Int
  showResult      Boolean       @default(true)
  published       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  questions       McqQuestion[]
  attempts        McqAttempt[]
}

model McqQuestion {
  id        String               @id @default(uuid())
  testId    String
  test      McqTest              @relation(fields: [testId], references: [id], onDelete: Cascade)
  text      String
  options   String[]
  /// Indexes into options. More than one means "select all that apply".
  correct   Int[]
  topic     String?
  /// Display order in the recruiter's list; bulk inserts share one createdAt so it can't order them
  position  Int
  createdAt DateTime             @default(now())
  paper     McqAttemptQuestion[]

  @@index([testId, position])
}

model McqAttempt {
  id            String               @id @default(uuid())
  testId        String
  test          McqTest              @relation(fields: [testId], references: [id], onDelete: Cascade)
  applicationId String               @unique
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startedAt     DateTime             @default(now())
  /// Enforced on the server; the browser's countdown is only a display
  expiresAt     DateTime
  submittedAt   DateTime?
  score         Int?
  total         Int?
  questions     McqAttemptQuestion[]
  events        McqEvent[]

  @@index([testId])
}

/// One question on one candidate's paper, in the order and with the option order they were shown.
model McqAttemptQuestion {
  id          String      @id @default(uuid())
  attemptId   String
  attempt     McqAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    McqQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex  Int
  /// optionOrder[i] is the original option index shown in position i
  optionOrder Int[]
  /// Original option indexes the candidate picked
  selected    Int[]
  answeredAt  DateTime?

  @@unique([attemptId, orderIndex])
  @@unique([attemptId, questionId])
}

model McqEvent {
  id        String       @id @default(uuid())
  attemptId String
  attempt   McqAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType McqEventType
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([attemptId])
}
