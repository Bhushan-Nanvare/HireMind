# Copy to .env and fill in. The server validates all of this at startup and lists anything missing.

# --- Required ---
DATABASE_URL=postgresql://hiremind:hiremind_dev@localhost:5432/hiremind
# 32+ random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# https://aistudio.google.com/apikey  (a free-tier key allows ~20 interview-scale calls per day)
GEMINI_API_KEY=

# --- Optional locally, required in production ---
PORT=5000
# Comma-separated browser origins allowed to call the API, e.g. https://your-app.vercel.app
CORS_ORIGINS=
# The frontend's public URL: email links point at it
APP_URL=http://localhost:5173
# Number of reverse-proxy hops in front of the server (set to 1 on Render, Railway, Fly...)
TRUST_PROXY=

# --- Email (without a key, emails are printed to this server's console) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend; the default test sender only reaches your own address
EMAIL_FROM=

# --- File storage: local disk, or any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase, MinIO) ---
STORAGE_DRIVER=local
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Region for AWS S3; endpoint for R2, Supabase or MinIO
S3_REGION=
S3_ENDPOINT=
