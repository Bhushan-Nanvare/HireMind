# Mounted over /app/.env inside the backend container.
# server.ts runs dotenv.config({ override: true }), so without this the host .env
# (which points at the hosted database) would override the compose environment.
# Secrets are not duplicated here; they come from backend/.env via env_file.
NODE_ENV=development
DATABASE_URL=postgresql://hiremind:hiremind_dev@postgres:5432/hiremind
PORT=5000
CORS_ORIGINS=http://localhost:5174
APP_URL=http://localhost:5174
STORAGE_DRIVER=local
