{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    // package.json has "type": "commonjs", so this emits CommonJS for `npm start`
    "module": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
